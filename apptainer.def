Bootstrap: docker
From: nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04

%labels
    Author Hugo
    Version v1.0.0
    Description Container for HI&RI 3D medical image segmentation project

%post
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3.11 \
        python3.11-dev \
        python3-pip \
        git \
        git-lfs \
        wget \
        curl \
        && rm -rf /var/lib/apt/lists/*
    
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1
    update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1

    python -m pip install --upgrade pip setuptools wheel
    
    pip install torch>=2.1 torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121
    
    pip install "monai[all]>=1.3" \
        "nnunetv2>=2.5" \
        "nibabel>=5.0" \
        "SimpleITK>=2.3" \
        numpy \
        scipy \
        scikit-learn \
        scikit-image \
        pandas \
        matplotlib \
        seaborn \
        tqdm \
        pyyaml \
        wandb \
        connected-components-3d \
        medpy \
        trimesh \
        click \
        pytest \
        pytest-cov

%environment
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8
    export CUDA_DEVICE_ORDER=PCI_BUS_ID

%help
    Container containing dependencies for the hiri-segmentation project, including PyTorch 2.1+, MONAI, and nnU-Net v2.
